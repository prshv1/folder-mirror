<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.folder-mirror</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON3}}</string>
        <string>{{HOME}}/.local/bin/folder-mirror</string>
        <string>--watch</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>MIRROR_DIR_A</key>
        <string>{{DIR_A}}</string>
        <key>MIRROR_DIR_B</key>
        <string>{{DIR_B}}</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{HOME}}/.local/state/folder-mirror/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/.local/state/folder-mirror/launchd.err.log</string>
</dict>
</plist>
