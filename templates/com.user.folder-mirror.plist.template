<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.folder-mirror</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON3}}</string>
        <string>{{HOME}}/.local/bin/folder-mirror</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>{{DIR_A}}</string>
        <string>{{DIR_B}}</string>
    </array>
    <key>StartInterval</key>
    <integer>5</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{HOME}}/.local/state/folder-mirror/sync.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/.local/state/folder-mirror/sync.err.log</string>
</dict>
</plist>
