DIR_A = Path(os.environ.get("MIRROR_DIR_A", str(Path.home() / "folder-a"))).expanduser()
DIR_B = Path(os.environ.get("MIRROR_DIR_B", str(Path.home() / "folder-b"))).expanduser()
STATE_DIR = Path(os.environ.get("FOLDER_MIRROR_STATE_DIR", str(Path.home() / ".local/state/folder-mirror"))).expanduser()
STATE_FILE = STATE_DIR / "state.json"
LOCK_FILE = STATE_DIR / "sync.lock"
WATCH_LOCK_FILE = STATE_DIR / "watch.lock"
ALERT_FILE = STATE_DIR / "last_alert.json"
GIT_HEAD_RECOVERY_FILE = STATE_DIR / "git_head_sync.json"
LOG_FILE = STATE_DIR / "sync.log"
ERR_LOG_FILE = STATE_DIR / "sync.err.log"
LAUNCHD_LOG_FILE = STATE_DIR / "launchd.log"
LAUNCHD_ERR_LOG_FILE = STATE_DIR / "launchd.err.log"
CONFLICTS_DIR = STATE_DIR / "conflicts"

MAX_LOG_BYTES = 256 * 1024
STALE_TMP_AGE_SECONDS = 300.0
MAX_CONFLICT_BACKUPS = 50
GIT_TIMEOUT_SECONDS = 30
NOTIFY_TIMEOUT_SECONDS = 3
WATCH_LATENCY_SECONDS = 0.35
WATCH_BUSY_RETRY_SECONDS = 0.5
WATCH_RECONCILE_SECONDS = 300.0
WATCH_RUNLOOP_SLICE_SECONDS = 2.0

# Only exclude .git internals from raw file copying; git refs are synced safely via git commands.
EXCLUDED_NAMES = {".git"}
TEMP_PREFIX = ".folder-mirror."
TEMP_SUFFIX = ".tmp"

# Any of these markers inside .git/ indicate an active git operation; defer the whole sync.
GIT_BUSY_MARKERS = (
    "index.lock",
    "HEAD.lock",
    "packed-refs.lock",
    "MERGE_HEAD",
    "REBASE_HEAD",
    "CHERRY_PICK_HEAD",
    "REVERT_HEAD",
    "BISECT_LOG",
    "rebase-merge",
    "rebase-apply",
)

# Git hook environment variables that override `git -C <repo>` and must be stripped.
GIT_ENV_STRIP = (
    "GIT_DIR",
    "GIT_WORK_TREE",
    "GIT_INDEX_FILE",
    "GIT_COMMON_DIR",
    "GIT_OBJECT_DIRECTORY",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_QUARANTINE_PATH",
    "GIT_PREFIX",
    "GIT_SUPER_PREFIX",
)


def is_temp_name(name: str) -> bool:
    return name.startswith(TEMP_PREFIX) and name.endswith(TEMP_SUFFIX)


def is_excluded(rel_parts: tuple[str, ...]) -> bool:
    return any(part in EXCLUDED_NAMES or is_temp_name(part) for part in rel_parts)


def log(msg: str, *, err: bool = False) -> None:
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}\n"
    target = ERR_LOG_FILE if err else LOG_FILE
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with target.open("a", encoding="utf-8") as fh:
            fh.write(line)
    except OSError:
        pass
    if os.environ.get("FOLDER_MIRROR_STDIO") == "1" or (sys.stderr.isatty() if err else sys.stdout.isatty()):
        stream = sys.stderr if err else sys.stdout
        print(line, end="", file=stream, flush=True)


def rotate_log_file(path: Path) -> None:
    """Atomically rotate append-per-write log files to <name>.1 when over MAX_LOG_BYTES."""
    try:
        if path.exists() and path.stat().st_size > MAX_LOG_BYTES:
            rotated = path.with_name(path.name + ".1")
            path.replace(rotated)
    except OSError:
        pass


def rotate_copytruncate_log_file(path: Path) -> None:
    """Copy-and-truncate logs held open by launchd so FDs keep writing to the active path."""
    try:
        if not path.exists() or path.stat().st_size <= MAX_LOG_BYTES:
            return
        rotated = path.with_name(path.name + ".1")
        tmp = path.with_name(path.name + ".1.tmp")
        shutil.copy2(path, tmp)
        tmp.replace(rotated)
        os.truncate(path, 0)
    except OSError:
        pass


def write_json_atomic(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    raw = json.dumps(payload, indent=2, sort_keys=True)
    with tmp.open("w", encoding="utf-8") as fh:
        fh.write(raw)
        fh.flush()
        os.fsync(fh.fileno())
    tmp.replace(path)


def notify_once(channel: str, alert_key: str, title: str, message: str) -> None:
    """Send a deduplicated macOS notification once per unique alert key per channel."""
    if os.environ.get("FOLDER_MIRROR_NO_NOTIFY") == "1" or sys.platform != "darwin":
        return
    alerts: dict[str, Any] = {}
    try:
        if ALERT_FILE.exists():
            prev = json.loads(ALERT_FILE.read_text(encoding="utf-8"))
            if isinstance(prev, dict):
                alerts = prev
                if alerts.get(channel) == alert_key:
                    return
    except (OSError, ValueError):
        pass

    alerts[channel] = alert_key
    alerts["ts"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    try:
        write_json_atomic(ALERT_FILE, alerts)
    except OSError:
        pass

    try:
        subprocess.run(
            [
                "/usr/bin/osascript",
                "-e",
                "on run argv",
                "-e",
                "display notification (item 1 of argv) with title (item 2 of argv)",
                "-e",
                "end run",
                "--",
                message,
                title,
            ],
            capture_output=True,
            text=True,
            timeout=NOTIFY_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def clear_alert(channel: str) -> None:
    try:
        if not ALERT_FILE.exists():
            return
        prev = json.loads(ALERT_FILE.read_text(encoding="utf-8"))
        if not isinstance(prev, dict) or channel not in prev:
            return
        prev.pop(channel, None)
        remaining = {k: v for k, v in prev.items() if k != "ts"}
        if not remaining:
            ALERT_FILE.unlink(missing_ok=True)
        else:
            write_json_atomic(ALERT_FILE, prev)
    except (OSError, ValueError):
        try:
            ALERT_FILE.unlink(missing_ok=True)
        except OSError:
            pass


def stat_meta(st: os.stat_result, entry_type: str) -> dict[str, int]:
    if entry_type == "symlink":
        return {
            "mtime_ns": st.st_mtime_ns,
            "ctime_ns": st.st_ctime_ns,
            "ino": st.st_ino,
        }
    return {
        "mtime_ns": st.st_mtime_ns,
        "ctime_ns": st.st_ctime_ns,
        "size": st.st_size,
        "ino": st.st_ino,
        "mode": st.st_mode & 0o777,
    }


def entry_sig(entry: dict[str, Any]) -> tuple[Any, ...]:
    return (entry.get("type"), entry.get("hash"), entry.get("mode"))


def matches_prev(cur: dict[str, Any], prev: dict[str, Any] | None) -> bool:
    if prev is None:
        return False
    if cur.get("type") != prev.get("type") or cur.get("hash") != prev.get("hash"):
        return False
    if prev.get("mode") is not None and cur.get("mode") != prev.get("mode"):
        return False
    return True


def file_signature(
    path: Path,
    side: str,
    cached: dict[str, Any] | None,
) -> dict[str, Any] | None:
    st = path.lstat()
    if stat.S_ISLNK(st.st_mode):
        target = os.readlink(path)
        digest = hashlib.sha256(f"symlink:{target}".encode("utf-8")).hexdigest()
        return {
            "type": "symlink",
            "target": target,
            "hash": digest,
            "mtime_ns": st.st_mtime_ns,
            "ctime_ns": st.st_ctime_ns,
            "meta": stat_meta(st, "symlink"),
        }

    if not stat.S_ISREG(st.st_mode):
        log(f"Skipping special non-regular file: {path}", err=True)
        return None

    meta = stat_meta(st, "file")
    if (
        cached is not None
        and cached.get("type") == "file"
        and cached.get(side) == meta
        and isinstance(cached.get("hash"), str)
    ):
        digest = cached["hash"]
    else:
        h = hashlib.sha256()
        with path.open("rb") as f:
            for chunk in iter(lambda: f.read(65536), b""):
                h.update(chunk)
        digest = h.hexdigest()

    return {
        "type": "file",
        "hash": digest,
        "mode": meta["mode"],
        "mtime_ns": st.st_mtime_ns,
        "ctime_ns": st.st_ctime_ns,
        "meta": meta,
    }


def cleanup_stale_temp(path: Path) -> None:
    try:
        st = path.lstat()
        if time.time() - st.st_mtime > STALE_TMP_AGE_SECONDS:
            if stat.S_ISDIR(st.st_mode) and not stat.S_ISLNK(st.st_mode):
                shutil.rmtree(path, ignore_errors=True)
                log(f"Cleaned stale temp directory: {path}")
            else:
                path.unlink(missing_ok=True)
                log(f"Cleaned stale temp file: {path}")
    except OSError:
        pass


def scan_dir(
    root: Path,
    side: str,
    prev_files: dict[str, dict[str, Any]],
) -> tuple[dict[str, dict[str, Any]], set[str]]:
    entries: dict[str, dict[str, Any]] = {}
    dirs: set[str] = set()
    if not root.exists():
        return entries, dirs

    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        rel_dir = Path(dirpath).relative_to(root)
        if str(rel_dir) != ".":
            dirs.add(rel_dir.as_posix())

        kept_dirs: list[str] = []
        for d in dirnames:
            rel_path = rel_dir / d if str(rel_dir) != "." else Path(d)
            full_path = root / rel_path
            if is_temp_name(d):
                cleanup_stale_temp(full_path)
                continue
            if is_excluded(rel_path.parts):
                continue
            try:
                if full_path.is_symlink():
                    rel_str = rel_path.as_posix()
                    sig = file_signature(full_path, side, prev_files.get(rel_str))
                    if sig is not None:
                        entries[rel_str] = sig
                else:
                    kept_dirs.append(d)
            except OSError as exc:
                log(f"Skipping unreadable directory entry {full_path}: {exc}", err=True)
        dirnames[:] = kept_dirs

        for name in filenames:
            rel_path = rel_dir / name if str(rel_dir) != "." else Path(name)
            full_path = root / rel_path
            if is_temp_name(name):
                cleanup_stale_temp(full_path)
                continue
            if is_excluded(rel_path.parts):
                continue
            rel_str = rel_path.as_posix()
            try:
                sig = file_signature(full_path, side, prev_files.get(rel_str))
                if sig is not None:
                    entries[rel_str] = sig
            except FileNotFoundError:
                continue
            except OSError as exc:
                log(f"Skipping unreadable file {full_path}: {exc}", err=True)

    return entries, dirs


def prune_conflict_backups() -> None:
    if not CONFLICTS_DIR.is_dir():
        return
    batches = sorted(p for p in CONFLICTS_DIR.iterdir() if p.is_dir())
    for old in batches[:-MAX_CONFLICT_BACKUPS]:
        shutil.rmtree(old, ignore_errors=True)


def backup_conflict(dst_root: Path, rel: str, losing_side: str) -> None:
    """Save a backup of the losing side (regular file or symlink target) on a conflict."""
    name = Path(rel).name
    if name == ".DS_Store" or name.startswith("._"):
        return
    dst = dst_root / rel
    try:
        ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
        if dst.is_symlink():
            target = os.readlink(dst)
            backup_path = CONFLICTS_DIR / f"{ts}_{losing_side}" / f"{rel}.symlink.txt"
            backup_path.parent.mkdir(parents=True, exist_ok=True)
            backup_path.write_text(f"{target}\n", encoding="utf-8")
            log(f"CONFLICT symlink backup saved ({rel} -> {target}): {backup_path}")
            notify_once(
                "conflict",
                f"symlink:{rel}:{ts}",
                "Folder Mirror Conflict Backup",
                f"Backed up losing symlink {rel} ({losing_side}) to conflicts/",
            )
            prune_conflict_backups()
            return
        if not dst.is_file():
            return
        backup_path = CONFLICTS_DIR / f"{ts}_{losing_side}" / rel
        backup_path.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(dst, backup_path)
        log(f"CONFLICT backup saved: {backup_path}")
        notify_once(
            "conflict",
            f"file:{rel}:{ts}",
            "Folder Mirror Conflict Backup",
            f"Backed up losing version of {rel} ({losing_side}) to conflicts/",
        )
        prune_conflict_backups()
    except OSError as exc:
        log(f"Warning: failed to back up conflict for {rel}: {exc}", err=True)


def copy_entry(
    src_root: Path,
    dst_root: Path,
    rel: str,
) -> tuple[str, str, int | None, dict[str, int]]:
    """Atomically copy a file or symlink from src_root/rel to dst_root/rel.

    Returns (entry_type, content_hash, mode_or_none, dst_stat_meta).
    Raises OSError if destination is a non-empty directory or copy fails.
    """
    src = src_root / rel
    dst = dst_root / rel
    dst.parent.mkdir(parents=True, exist_ok=True)

    # Never destructively rmtree a non-empty directory on a file<->dir collision.
    if dst.is_dir() and not dst.is_symlink():
        if any(dst.iterdir()):
            raise IsADirectoryError(f"Destination is a non-empty directory: {dst}")
        dst.rmdir()

    if src.is_symlink():
        target = os.readlink(src)
        digest = hashlib.sha256(f"symlink:{target}".encode("utf-8")).hexdigest()
        tmp_path = dst.parent / f"{TEMP_PREFIX}{os.getpid()}.{secrets.token_hex(6)}{TEMP_SUFFIX}"
        try:
            os.symlink(target, tmp_path)
            os.replace(tmp_path, dst)
        except Exception:
            if tmp_path.is_symlink() or tmp_path.exists():
                tmp_path.unlink(missing_ok=True)
            raise
        return "symlink", digest, None, stat_meta(dst.lstat(), "symlink")

    h = hashlib.sha256()
    fd, tmp_name = tempfile.mkstemp(
        dir=dst.parent,
        prefix=f"{TEMP_PREFIX}{os.getpid()}.",
        suffix=TEMP_SUFFIX,
    )
    tmp_path = Path(tmp_name)
    try:
        with os.fdopen(fd, "wb") as dst_fh, src.open("rb") as src_fh:
            for chunk in iter(lambda: src_fh.read(65536), b""):
                h.update(chunk)
                dst_fh.write(chunk)
        shutil.copystat(src, tmp_path)
        os.replace(tmp_path, dst)
    except Exception:
        tmp_path.unlink(missing_ok=True)
        raise

    dst_st = dst.lstat()
    dst_meta = stat_meta(dst_st, "file")
    return "file", h.hexdigest(), dst_meta["mode"], dst_meta


def remove_entry(root: Path, rel: str) -> None:
    target = root / rel
    if target.is_symlink() or target.is_file():
        target.unlink(missing_ok=True)
    elif target.is_dir():
        if any(target.iterdir()):
            raise IsADirectoryError(f"Refusing to remove non-empty directory: {target}")
        target.rmdir()


def load_state() -> dict[str, Any]:
    default: dict[str, Any] = {"files": {}, "dirs": [], "git": {}}
    if not STATE_FILE.exists():
        return default
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            log("Warning: state.json root is not a dict; resetting baseline", err=True)
            return default
        return {
            "files": data.get("files", {}) if isinstance(data.get("files"), dict) else {},
            "dirs": data.get("dirs", []) if isinstance(data.get("dirs"), list) else [],
            "git": data.get("git", {}) if isinstance(data.get("git"), dict) else {},
        }
    except Exception as exc:
        log(f"Warning: failed to parse state.json ({exc}); resetting baseline", err=True)
        return default


def save_state(state: dict[str, Any]) -> None:
    write_json_atomic(STATE_FILE, state)


def is_git_busy(repo: Path) -> bool:
    git_dir = repo / ".git"
    if not git_dir.is_dir():
        return False
    if any((git_dir / marker).exists() for marker in GIT_BUSY_MARKERS):
        return True
    refs_dir = git_dir / "refs"
    if refs_dir.is_dir():
        try:
            if any(refs_dir.rglob("*.lock")):
                return True
        except OSError:
            return True
    return False


def git_meta_fingerprint(repo: Path) -> str | None:
    """Fast pure-Python fingerprint of .git metadata so idle runs spawn 0 git subprocesses."""
    git_dir = repo / ".git"
    if not git_dir.is_dir():
        return None
    parts: list[str] = []
    for rel in ("HEAD", "packed-refs", "config", "index"):
        p = git_dir / rel
        try:
            st = p.lstat()
            parts.append(f"{rel}:{st.st_mtime_ns}:{st.st_ctime_ns}:{st.st_size}:{st.st_ino}")
        except FileNotFoundError:
            parts.append(f"{rel}:missing")
        except OSError:
            return None
    refs_dir = git_dir / "refs"
    if refs_dir.is_dir():
        ref_entries: list[str] = []
        try:
            for dirpath, dirnames, filenames in os.walk(refs_dir, followlinks=False):
                dirnames.sort()
                filenames.sort()
                rel_dir = Path(dirpath).relative_to(git_dir)
                for fn in filenames:
                    fp = Path(dirpath) / fn
                    st = fp.lstat()
                    ref_entries.append(
                        f"{(rel_dir / fn).as_posix()}:{st.st_mtime_ns}:{st.st_ctime_ns}:{st.st_size}:{st.st_ino}"
                    )
        except OSError:
            return None
        parts.extend(ref_entries)
    return hashlib.sha256("\n".join(parts).encode("utf-8")).hexdigest()


def sanitized_git_env(
    *,
    set_sync_guard: bool = False,
    extra_env: dict[str, str] | None = None,
) -> dict[str, str]:
    env = {k: v for k, v in os.environ.items() if k not in GIT_ENV_STRIP}
    if set_sync_guard:
        env["FOLDER_MIRROR_GIT_SYNC"] = "1"
    if extra_env:
        env.update(extra_env)
    return env


def git_run(
    repo: Path,
    *args: str,
    sync_guard: bool = False,
    extra_env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            ["git", "-C", str(repo), *args],
            capture_output=True,
            text=True,
            env=sanitized_git_env(set_sync_guard=sync_guard, extra_env=extra_env),
            timeout=GIT_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        log(f"GIT timeout ({GIT_TIMEOUT_SECONDS}s) in {repo}: git {' '.join(args)}", err=True)
        return subprocess.CompletedProcess(
            args=["git", "-C", str(repo), *args],
            returncode=124,
            stdout="",
            stderr="timeout",
        )


def git_out(repo: Path, *args: str) -> str | None:
    res = git_run(repo, *args)
    return res.stdout.strip() if res.returncode == 0 else None


def git_has_staged_changes(repo: Path) -> bool:
    res = git_run(repo, "diff", "--cached", "--quiet")
    return res.returncode != 0


def git_is_ancestor_cross_repo(
    repo: Path,
    other_repo: Path,
    ancestor: str,
    descendant: str,
) -> bool:
    """Strictly read-only ancestry check across both local object stores without touching FETCH_HEAD."""
    alt_objects = str(other_repo / ".git" / "objects")
    res = git_run(
        repo,
        "merge-base",
        "--is-ancestor",
        ancestor,
        descendant,
        extra_env={"GIT_ALTERNATE_OBJECT_DIRECTORIES": alt_objects},
    )
    return res.returncode == 0


def recover_interrupted_git_head() -> None:
    """Finish index alignment if a previous run was killed mid-apply_git_head."""
    if not GIT_HEAD_RECOVERY_FILE.exists():
        return
    try:
        data = json.loads(GIT_HEAD_RECOVERY_FILE.read_text(encoding="utf-8"))
        dst_str = data.get("dst")
        target_branch = data.get("target_branch")
        target_head = data.get("target_head")
        if isinstance(dst_str, str) and isinstance(target_branch, str) and isinstance(target_head, str):
            dst = Path(dst_str).resolve()
            if dst in (DIR_A.resolve(), DIR_B.resolve()) and (dst / ".git").is_dir():
                cur_branch, cur_head = git_head_info(dst)
                if cur_branch == target_branch and cur_head == target_head:
                    res = git_run(dst, "reset", "--quiet", "--mixed", "HEAD", sync_guard=True)
                    if res.returncode == 0:
                        log(f"GIT recovery completed index reset in {dst} ({target_branch}@{target_head[:7]})")
                    else:
                        log(f"GIT recovery reset failed in {dst}: {res.stderr.strip()}", err=True)
                        return
    except Exception as exc:
        log(f"Warning: failed to process git_head_sync recovery marker: {exc}", err=True)
    try:
        GIT_HEAD_RECOVERY_FILE.unlink(missing_ok=True)
    except OSError:
        pass


def git_all_refs(repo: Path) -> tuple[dict[str, str], dict[str, str], dict[str, str]]:
    """Read refs/heads, refs/remotes/origin, and refs/tags in a single git invocation."""
    out = git_out(
        repo,
        "for-each-ref",
        "--format=%(refname) %(objectname) %(symref)",
        "refs/heads",
        "refs/remotes/origin",
        "refs/tags",
    )
    heads: dict[str, str] = {}
    remotes: dict[str, str] = {}
    tags: dict[str, str] = {}
    if not out:
        return heads, remotes, tags
    for line in out.splitlines():
        parts = line.split(" ")
        if len(parts) < 2:
            continue
        refname, oid = parts[0], parts[1]
        symref = parts[2] if len(parts) >= 3 else ""
        if symref:
            continue
        if refname.startswith("refs/heads/"):
            heads[refname] = oid
        elif refname.startswith("refs/remotes/origin/"):
            remotes[refname] = oid
        elif refname.startswith("refs/tags/"):
            tags[refname] = oid
    return heads, remotes, tags


def git_all_branch_tracking(repo: Path) -> dict[str, dict[str, str]]:
    """Read branch.*.remote and branch.*.merge in a single git config invocation."""
    out = git_out(repo, "config", "--get-regexp", r"^branch\..*\.(remote|merge)$")
    raw: dict[str, dict[str, str]] = {}
    if not out:
        return {}
    for line in out.splitlines():
        key, _, val = line.partition(" ")
        if not val or not key.startswith("branch."):
            continue
        if key.endswith(".remote"):
            branch = key[len("branch.") : -len(".remote")]
            raw.setdefault(branch, {})["remote"] = val
        elif key.endswith(".merge"):
            branch = key[len("branch.") : -len(".merge")]
            raw.setdefault(branch, {})["merge"] = val
    return {
        b: {"remote": d["remote"], "merge": d["merge"]}
        for b, d in raw.items()
        if "remote" in d and "merge" in d
    }


def set_branch_tracking(repo: Path, branch: str, tracking: dict[str, str] | None) -> tuple[bool, str]:
    if tracking is None:
        r1 = git_run(repo, "config", "--unset", f"branch.{branch}.remote", sync_guard=True)
        r2 = git_run(repo, "config", "--unset", f"branch.{branch}.merge", sync_guard=True)
        # git config --unset returns 5 when key does not exist; treat 0 or 5 as success.
        ok = r1.returncode in (0, 5) and r2.returncode in (0, 5)
        err = "; ".join(s for s in (r1.stderr.strip(), r2.stderr.strip()) if s)
        return ok, err
    r1 = git_run(repo, "config", f"branch.{branch}.remote", tracking["remote"], sync_guard=True)
    r2 = git_run(repo, "config", f"branch.{branch}.merge", tracking["merge"], sync_guard=True)
    ok = r1.returncode == 0 and r2.returncode == 0
    err = "; ".join(s for s in (r1.stderr.strip(), r2.stderr.strip()) if s)
    return ok, err


def git_head_info(repo: Path) -> tuple[str | None, str | None]:
    branch = git_out(repo, "symbolic-ref", "--quiet", "--short", "HEAD")
    head = git_out(repo, "rev-parse", "HEAD")
    return branch, head


def decide_git_head_direction(
    prev_git: dict[str, Any],
    source: str | None,
) -> tuple[str, str | None, str | None, str | None, str | None]:
    """Return (direction, branch_a, head_a, branch_b, head_b).

    direction is "A->B", "B->A", "EQUAL", "DETACHED_EQUAL", "DETACHED_MISMATCH",
    "CONFLICT", or "UNBORN". Strictly read-only (never mutates FETCH_HEAD or objects).
    """
    branch_a, head_a = git_head_info(DIR_A)
    branch_b, head_b = git_head_info(DIR_B)

    if not head_a or not head_b:
        return "UNBORN", branch_a, head_a, branch_b, head_b

    if branch_a is None or branch_b is None:
        if branch_a is None and branch_b is None and head_a == head_b:
            return "DETACHED_EQUAL", None, head_a, None, head_b
        return "DETACHED_MISMATCH", branch_a, head_a, branch_b, head_b

    a_state = (branch_a, head_a)
    b_state = (branch_b, head_b)
    p_state = (prev_git.get("branch"), prev_git.get("head"))

    if a_state == b_state:
        return "EQUAL", branch_a, head_a, branch_b, head_b
    if a_state != p_state and b_state == p_state:
        return "A->B", branch_a, head_a, branch_b, head_b
    if b_state != p_state and a_state == p_state:
        return "B->A", branch_a, head_a, branch_b, head_b
    if branch_a == branch_b:
        if git_is_ancestor_cross_repo(DIR_A, DIR_B, head_a, head_b):
            return "B->A", branch_a, head_a, branch_b, head_b
        if git_is_ancestor_cross_repo(DIR_A, DIR_B, head_b, head_a):
            return "A->B", branch_a, head_a, branch_b, head_b
    # If baseline is missing (e.g. first run or state reset) and a git hook explicitly
    # fired on one side, honor the triggering hook's direction instead of deadlocking.
    if p_state == (None, None) and source in ("A", "B"):
        return ("A->B" if source == "A" else "B->A"), branch_a, head_a, branch_b, head_b
    return "CONFLICT", branch_a, head_a, branch_b, head_b


def check_git_preconditions(
    prev_git: dict[str, Any],
    source: str | None,
) -> tuple[bool, bool, tuple[str, str | None, str | None, str | None, str | None] | None]:
    """Check Git state before touching working-tree files (strictly read-only).

    Returns (should_defer, git_unchanged_fastpath, precomputed_decision).
    """
    if not (DIR_A / ".git").exists() or not (DIR_B / ".git").exists():
        return False, True, None

    meta_a = git_meta_fingerprint(DIR_A)
    meta_b = git_meta_fingerprint(DIR_B)
    if (
        source is None
        and meta_a is not None
        and meta_b is not None
        and prev_git.get("head")
        and meta_a == prev_git.get("meta_a")
        and meta_b == prev_git.get("meta_b")
    ):
        clear_alert("git")
        return False, True, None

    decision = decide_git_head_direction(prev_git, source)
    direction, branch_a, head_a, branch_b, head_b = decision

    if direction == "CONFLICT" and branch_a and branch_b and head_a and head_b:
        msg = f"A={branch_a}@{head_a[:7]} vs B={branch_b}@{head_b[:7]} diverged"
        log(f"GIT defer: {msg}; skipping sync to avoid split-brain", err=True)
        notify_once("git", f"conflict:{branch_a}@{head_a}|{branch_b}@{head_b}", "Folder Mirror Paused (Git Conflict)", msg)
        return True, False, decision
    if direction == "DETACHED_MISMATCH":
        a_desc = f"{branch_a or 'detached'}@{head_a[:7] if head_a else 'none'}"
        b_desc = f"{branch_b or 'detached'}@{head_b[:7] if head_b else 'none'}"
        msg = f"A={a_desc} vs B={b_desc} detached HEAD mismatch"
        log(f"GIT defer: {msg}; skipping sync to avoid split-brain", err=True)
        notify_once("git", f"detached:{a_desc}|{b_desc}", "Folder Mirror Paused (Detached HEAD)", msg)
        return True, False, decision
    if direction == "UNBORN":
        log("GIT defer: one or both repos have an unborn/missing HEAD", err=True)
        return True, False, decision
    if direction == "A->B" and git_has_staged_changes(DIR_B):
        log(f"GIT defer A->B: destination {DIR_B} has staged changes", err=True)
        return True, False, decision
    if direction == "B->A" and git_has_staged_changes(DIR_A):
        log(f"GIT defer B->A: destination {DIR_A} has staged changes", err=True)
        return True, False, decision

    clear_alert("git")
    return False, False, decision


def apply_git_head(
    src: Path,
    dst: Path,
    src_branch: str,
    src_head: str,
    dst_branch: str,
    label: str,
    actions: list[str],
) -> bool:
    if git_has_staged_changes(dst):
        log(f"GIT skip {label}: destination {dst} has staged changes", err=True)
        return False

    # Fetch without writing FETCH_HEAD so user's FETCH_HEAD is never clobbered.
    r1 = git_run(
        dst,
        "fetch",
        "--quiet",
        "--no-tags",
        "--no-write-fetch-head",
        str(src),
        f"refs/heads/{src_branch}",
        sync_guard=True,
    )
    if r1.returncode != 0:
        log(f"GIT error {label} fetch refs/heads/{src_branch}: {r1.stderr.strip()}", err=True)
        return False

    r_chk = git_run(dst, "cat-file", "-e", f"{src_head}^{{commit}}")
    if r_chk.returncode != 0:
        log(f"GIT error {label}: fetched commit {src_head[:7]} missing in {dst}", err=True)
        return False

    try:
        write_json_atomic(
            GIT_HEAD_RECOVERY_FILE,
            {"dst": str(dst), "target_branch": src_branch, "target_head": src_head},
        )
    except OSError:
        pass

    if src_branch != dst_branch:
        r2 = git_run(dst, "update-ref", f"refs/heads/{src_branch}", src_head, sync_guard=True)
        if r2.returncode != 0:
            log(f"GIT error {label} update-ref {src_branch}: {r2.stderr.strip()}", err=True)
            GIT_HEAD_RECOVERY_FILE.unlink(missing_ok=True)
            return False
        r3 = git_run(dst, "symbolic-ref", "HEAD", f"refs/heads/{src_branch}", sync_guard=True)
        if r3.returncode != 0:
            log(f"GIT error {label} symbolic-ref {src_branch}: {r3.stderr.strip()}", err=True)
            GIT_HEAD_RECOVERY_FILE.unlink(missing_ok=True)
            return False
        r4 = git_run(dst, "reset", "--quiet", "--mixed", "HEAD", sync_guard=True)
        if r4.returncode != 0:
            log(f"GIT error {label} reset --mixed HEAD: {r4.stderr.strip()}", err=True)
            return False
    else:
        r2 = git_run(dst, "reset", "--quiet", "--mixed", src_head, sync_guard=True)
        if r2.returncode != 0:
            log(f"GIT error {label} reset --mixed {src_head[:7]}: {r2.stderr.strip()}", err=True)
            return False

    GIT_HEAD_RECOVERY_FILE.unlink(missing_ok=True)
    new_head = git_out(dst, "rev-parse", "--short", "HEAD") or ""
    actions.append(f"GIT {label} {src_branch}@{new_head}")
    return True


def sync_ref_map(
    refs_a: dict[str, str],
    refs_b: dict[str, str],
    prev_refs: dict[str, str],
    actions: list[str],
    *,
    skip_refs: set[str] | None = None,
) -> tuple[dict[str, str], bool]:
    """3-way sync a map of refs between DIR_A and DIR_B without mutating FETCH_HEAD."""
    skip = skip_refs or set()
    new_refs: dict[str, str] = {}
    had_error = False

    for ref in sorted(set(refs_a) | set(refs_b) | set(prev_refs)):
        oid_a = refs_a.get(ref)
        oid_b = refs_b.get(ref)
        oid_p = prev_refs.get(ref)

        if ref in skip:
            if oid_a and oid_a == oid_b:
                new_refs[ref] = oid_a
            elif oid_p:
                new_refs[ref] = oid_p
            continue

        if oid_a == oid_b:
            if oid_a is not None:
                new_refs[ref] = oid_a
            continue

        if oid_a and oid_b:
            a_chg = oid_a != oid_p
            b_chg = oid_b != oid_p
            if a_chg and not b_chg:
                r = git_run(
                    DIR_B,
                    "fetch",
                    "--quiet",
                    "--no-tags",
                    "--no-write-fetch-head",
                    str(DIR_A),
                    f"+{ref}:{ref}",
                    sync_guard=True,
                )
                if r.returncode == 0:
                    new_refs[ref] = oid_a
                    actions.append(f"GIT A->B {ref}->{oid_a[:7]}")
                else:
                    had_error = True
                    log(f"GIT error A->B {ref}: {r.stderr.strip()}", err=True)
                    if oid_p:
                        new_refs[ref] = oid_p
            elif b_chg and not a_chg:
                r = git_run(
                    DIR_A,
                    "fetch",
                    "--quiet",
                    "--no-tags",
                    "--no-write-fetch-head",
                    str(DIR_B),
                    f"+{ref}:{ref}",
                    sync_guard=True,
                )
                if r.returncode == 0:
                    new_refs[ref] = oid_b
                    actions.append(f"GIT B->A {ref}->{oid_b[:7]}")
                else:
                    had_error = True
                    log(f"GIT error B->A {ref}: {r.stderr.strip()}", err=True)
                    if oid_p:
                        new_refs[ref] = oid_p
            else:
                if git_is_ancestor_cross_repo(DIR_A, DIR_B, oid_a, oid_b):
                    r = git_run(
                        DIR_A,
                        "fetch",
                        "--quiet",
                        "--no-tags",
                        "--no-write-fetch-head",
                        str(DIR_B),
                        f"+{ref}:{ref}",
                        sync_guard=True,
                    )
                    if r.returncode == 0:
                        new_refs[ref] = oid_b
                        actions.append(f"GIT B->A {ref}->{oid_b[:7]}")
                    else:
                        had_error = True
                        log(f"GIT error B->A fast-forward {ref}: {r.stderr.strip()}", err=True)
                        if oid_p:
                            new_refs[ref] = oid_p
                elif git_is_ancestor_cross_repo(DIR_A, DIR_B, oid_b, oid_a):
                    r = git_run(
                        DIR_B,
                        "fetch",
                        "--quiet",
                        "--no-tags",
                        "--no-write-fetch-head",
                        str(DIR_A),
                        f"+{ref}:{ref}",
                        sync_guard=True,
                    )
                    if r.returncode == 0:
                        new_refs[ref] = oid_a
                        actions.append(f"GIT A->B {ref}->{oid_a[:7]}")
                    else:
                        had_error = True
                        log(f"GIT error A->B fast-forward {ref}: {r.stderr.strip()}", err=True)
                        if oid_p:
                            new_refs[ref] = oid_p
                else:
                    had_error = True
                    log(
                        f"GIT conflict on {ref}: A={oid_a[:7]} vs B={oid_b[:7]} diverged; manual reconciliation needed",
                        err=True,
                    )
                    if oid_p:
                        new_refs[ref] = oid_p
        elif oid_a and not oid_b:
            if oid_p is not None and oid_a == oid_p:
                r = git_run(DIR_A, "update-ref", "-d", ref, sync_guard=True)
                if r.returncode == 0:
                    actions.append(f"GIT DEL A {ref}")
                else:
                    had_error = True
                    log(f"GIT error DEL A {ref}: {r.stderr.strip()}", err=True)
                    new_refs[ref] = oid_p
            else:
                r = git_run(
                    DIR_B,
                    "fetch",
                    "--quiet",
                    "--no-tags",
                    "--no-write-fetch-head",
                    str(DIR_A),
                    f"+{ref}:{ref}",
                    sync_guard=True,
                )
                if r.returncode == 0:
                    new_refs[ref] = oid_a
                    actions.append(f"GIT A->B {ref}->{oid_a[:7]}")
                else:
                    had_error = True
                    log(f"GIT error A->B {ref}: {r.stderr.strip()}", err=True)
        elif oid_b and not oid_a:
            if oid_p is not None and oid_b == oid_p:
                r = git_run(DIR_B, "update-ref", "-d", ref, sync_guard=True)
                if r.returncode == 0:
                    actions.append(f"GIT DEL B {ref}")
                else:
                    had_error = True
                    log(f"GIT error DEL B {ref}: {r.stderr.strip()}", err=True)
                    new_refs[ref] = oid_p
            else:
                r = git_run(
                    DIR_A,
                    "fetch",
                    "--quiet",
                    "--no-tags",
                    "--no-write-fetch-head",
                    str(DIR_B),
                    f"+{ref}:{ref}",
                    sync_guard=True,
                )
                if r.returncode == 0:
                    new_refs[ref] = oid_b
                    actions.append(f"GIT B->A {ref}->{oid_b[:7]}")
                else:
                    had_error = True
                    log(f"GIT error B->A {ref}: {r.stderr.strip()}", err=True)

    return new_refs, had_error


def sync_branch_tracking_configs(
    branches: set[str],
    prev_tracking: dict[str, dict[str, str]],
    actions: list[str],
) -> tuple[dict[str, dict[str, str]], bool]:
    """3-way sync branch.<name>.remote and branch.<name>.merge using 1 config read per repo."""
    all_a = git_all_branch_tracking(DIR_A)
    all_b = git_all_branch_tracking(DIR_B)
    new_tracking: dict[str, dict[str, str]] = {}
    had_error = False

    for branch in sorted(branches):
        tr_a = all_a.get(branch)
        tr_b = all_b.get(branch)
        tr_p = prev_tracking.get(branch)

        if tr_a == tr_b:
            if tr_a is not None:
                new_tracking[branch] = tr_a
            continue

        a_chg = tr_a != tr_p
        b_chg = tr_b != tr_p
        if a_chg and not b_chg:
            ok, err = set_branch_tracking(DIR_B, branch, tr_a)
            if ok:
                if tr_a is not None:
                    new_tracking[branch] = tr_a
                actions.append(f"GIT A->B tracking {branch}")
            else:
                had_error = True
                log(f"GIT error A->B tracking {branch}: {err}", err=True)
                if tr_p is not None:
                    new_tracking[branch] = tr_p
        elif b_chg and not a_chg:
            ok, err = set_branch_tracking(DIR_A, branch, tr_b)
            if ok:
                if tr_b is not None:
                    new_tracking[branch] = tr_b
                actions.append(f"GIT B->A tracking {branch}")
            else:
                had_error = True
                log(f"GIT error B->A tracking {branch}: {err}", err=True)
                if tr_p is not None:
                    new_tracking[branch] = tr_p
        elif tr_a is not None and tr_b is None:
            ok, err = set_branch_tracking(DIR_B, branch, tr_a)
            if ok:
                new_tracking[branch] = tr_a
                actions.append(f"GIT A->B tracking {branch}")
            else:
                had_error = True
                log(f"GIT error A->B tracking {branch}: {err}", err=True)
        elif tr_b is not None and tr_a is None:
            ok, err = set_branch_tracking(DIR_A, branch, tr_b)
            if ok:
                new_tracking[branch] = tr_b
                actions.append(f"GIT B->A tracking {branch}")
            else:
                had_error = True
                log(f"GIT error B->A tracking {branch}: {err}", err=True)
        else:
            had_error = True
            log(
                f"GIT conflict on branch.{branch} tracking config: A={tr_a} vs B={tr_b}; manual reconciliation needed",
                err=True,
            )
            if tr_p is not None:
                new_tracking[branch] = tr_p

    return new_tracking, had_error


def sync_git_state(
    prev_git: dict[str, Any],
    precomputed: tuple[str, str | None, str | None, str | None, str | None],
    actions: list[str],
) -> dict[str, Any]:
    """Keep both local git repos aligned (HEAD, all local branches, remotes, tags, tracking)."""
    if not (DIR_A / ".git").exists() or not (DIR_B / ".git").exists():
        return prev_git

    # Re-check git busy & HEAD stability to close the TOCTOU window after file mirroring.
    if is_git_busy(DIR_A) or is_git_busy(DIR_B):
        return prev_git

    direction, branch_a, head_a, branch_b, head_b = precomputed
    cur_branch_a, cur_head_a = git_head_info(DIR_A)
    cur_branch_b, cur_head_b = git_head_info(DIR_B)
    if (cur_branch_a, cur_head_a, cur_branch_b, cur_head_b) != (branch_a, head_a, branch_b, head_b):
        log("GIT defer: HEAD changed mid-sync; retrying on next run", err=True)
        return prev_git

    new_git: dict[str, Any] = dict(prev_git)
    had_error = False
    active_branch: str | None = None

    if direction == "EQUAL" and branch_a and head_a:
        new_git["branch"] = branch_a
        new_git["head"] = head_a
        active_branch = branch_a
    elif direction == "DETACHED_EQUAL" and head_a:
        new_git["branch"] = None
        new_git["head"] = head_a
    elif direction == "A->B" and branch_a and branch_b and head_a:
        if apply_git_head(DIR_A, DIR_B, branch_a, head_a, branch_b, "A->B", actions):
            new_git["branch"] = branch_a
            new_git["head"] = head_a
            active_branch = branch_a
        else:
            had_error = True
    elif direction == "B->A" and branch_a and branch_b and head_b:
        if apply_git_head(DIR_B, DIR_A, branch_b, head_b, branch_a, "B->A", actions):
            new_git["branch"] = branch_b
            new_git["head"] = head_b
            active_branch = branch_b
        else:
            had_error = True
    else:
        log(f"GIT error: unexpected HEAD sync state direction={direction!r}", err=True)
        had_error = True

    skip_heads: set[str] = set()
    if active_branch:
        skip_heads.add(f"refs/heads/{active_branch}")
    else:
        if branch_a:
            skip_heads.add(f"refs/heads/{branch_a}")
        if branch_b:
            skip_heads.add(f"refs/heads/{branch_b}")

    heads_a, remotes_a, tags_a = git_all_refs(DIR_A)
    heads_b, remotes_b, tags_b = git_all_refs(DIR_B)

    prev_heads = prev_git.get("heads", {}) if isinstance(prev_git.get("heads"), dict) else {}
    prev_remotes = prev_git.get("remotes", {}) if isinstance(prev_git.get("remotes"), dict) else {}
    prev_tags = prev_git.get("tags", {}) if isinstance(prev_git.get("tags"), dict) else {}
    prev_tracking = prev_git.get("tracking", {}) if isinstance(prev_git.get("tracking"), dict) else {}

    new_heads, err_h = sync_ref_map(heads_a, heads_b, prev_heads, actions, skip_refs=skip_heads)
    new_remotes, err_r = sync_ref_map(remotes_a, remotes_b, prev_remotes, actions)
    new_tags, err_t = sync_ref_map(tags_a, tags_b, prev_tags, actions)

    common_branches = {r.removeprefix("refs/heads/") for r in new_heads}
    if active_branch:
        common_branches.add(active_branch)
    new_tracking, err_tr = sync_branch_tracking_configs(common_branches, prev_tracking, actions)

    new_git["heads"] = new_heads
    new_git["remotes"] = new_remotes
    new_git["tags"] = new_tags
    new_git["tracking"] = new_tracking

    if not (had_error or err_h or err_r or err_t or err_tr):
        meta_a = git_meta_fingerprint(DIR_A)
        meta_b = git_meta_fingerprint(DIR_B)
        if meta_a and meta_b:
            new_git["meta_a"] = meta_a
            new_git["meta_b"] = meta_b
    else:
        new_git.pop("meta_a", None)
        new_git.pop("meta_b", None)

    return new_git


def acquire_lock(lock_fh: Any, wait_seconds: float) -> bool:
    deadline = time.monotonic() + max(0.0, wait_seconds)
    while True:
        try:
            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            if time.monotonic() >= deadline:
                return False
            time.sleep(0.05)


def rename_dir_case(root: Path, old_rel: str, new_rel: str) -> bool:
    """Two-step case-only rename on APFS so directory casing matches canonical target."""
    src = root / old_rel
    dst = root / new_rel
    if not src.is_dir() or src.is_symlink():
        return False
    tmp = src.parent / f"{TEMP_PREFIX}{os.getpid()}.{secrets.token_hex(6)}{TEMP_SUFFIX}"
    try:
        os.rename(src, tmp)
        try:
            os.rename(tmp, dst)
        except OSError:
            os.rename(tmp, src)
            raise
        return True
    except OSError as exc:
        log(f"Error CASE-NORM {src} -> {dst}: {exc}", err=True)
        return False


def reconcile_dir_case_collisions(
    dirs_a: set[str],
    dirs_b: set[str],
    prev_dirs: set[str],
    actions: list[str],
) -> bool:
    """Normalize APFS directory-segment case collisions shallowest-first before file planning.

    Returns True if any directory was renamed (caller should re-scan).
    """
    cf_a: dict[str, str] = {d.casefold(): d for d in dirs_a}
    cf_b: dict[str, str] = {d.casefold(): d for d in dirs_b}
    common_cf = sorted(set(cf_a) & set(cf_b), key=lambda x: (x.count("/"), x))
    for cf in common_cf:
        da, db = cf_a[cf], cf_b[cf]
        if da == db:
            continue
        # Only normalize the shallowest differing segment first; re-scan updates children.
        if Path(da).parent.as_posix() != Path(db).parent.as_posix():
            continue
        if da in prev_dirs and db not in prev_dirs:
            # B renamed da -> db
            if rename_dir_case(DIR_A, da, db):
                actions.append(f"CASE-NORM A {da} -> {db}")
                return True
        elif db in prev_dirs and da not in prev_dirs:
            # A renamed db -> da
            if rename_dir_case(DIR_B, db, da):
                actions.append(f"CASE-NORM B {db} -> {da}")
                return True
        else:
            # Both created or both in prev with different casing: newer dir mtime wins (tie -> A).
            try:
                st_a = (DIR_A / da).lstat()
                st_b = (DIR_B / db).lstat()
                a_wins = (st_a.st_mtime_ns, st_a.st_ctime_ns) >= (st_b.st_mtime_ns, st_b.st_ctime_ns)
            except OSError:
                a_wins = True
            if a_wins:
                if rename_dir_case(DIR_B, db, da):
                    actions.append(f"CASE-NORM B {db} -> {da}")
                    return True
            else:
                if rename_dir_case(DIR_A, da, db):
                    actions.append(f"CASE-NORM A {da} -> {db}")
                    return True
    return False


def sync_once(*, wait_seconds: float = 0.0, source: str | None = None) -> tuple[int, bool]:
    """Run one sync pass. Returns (exit_code, busy_deferred)."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("a+") as lock_fh:
        if not acquire_lock(lock_fh, wait_seconds):
            if wait_seconds > 0:
                log(f"Skipping sync: lock busy after {wait_seconds:.1f}s", err=True)
            return 0, True

        if not DIR_A.exists() or not DIR_B.exists():
            log(f"Skipping sync: missing directory ({DIR_A.exists()=}, {DIR_B.exists()=})", err=True)
            return 1, False

        # Defer the ENTIRE sync if either repo is mid-git-operation (commit/merge/rebase/checkout).
        if is_git_busy(DIR_A) or is_git_busy(DIR_B):
            return 0, True

        recover_interrupted_git_head()

        prev_state = load_state()
        prev_files: dict[str, dict[str, Any]] = prev_state["files"]
        prev_dirs: set[str] = set(prev_state["dirs"])
        prev_git: dict[str, Any] = prev_state["git"]

        # Defer before mutating working trees if Git HEAD is diverged, detached, or staged-conflicted.
        should_defer, git_fastpath, precomputed_git = check_git_preconditions(prev_git, source)
        if should_defer:
            return 0, False

        actions: list[str] = []
        snap_a, dirs_a = scan_dir(DIR_A, "a", prev_files)
        snap_b, dirs_b = scan_dir(DIR_B, "b", prev_files)

        # Reconcile APFS directory-level case collisions (e.g. Foo/a.txt vs foo/b.txt) before planning.
        for _ in range(10):
            if not reconcile_dir_case_collisions(dirs_a, dirs_b, prev_dirs, actions):
                break
            snap_a, dirs_a = scan_dir(DIR_A, "a", prev_files)
            snap_b, dirs_b = scan_dir(DIR_B, "b", prev_files)

        all_paths = sorted(set(snap_a) | set(snap_b) | set(prev_files))
        new_files: dict[str, dict[str, Any]] = {}
        collision_errors: list[str] = []

        # Plan operations so deletions run before copies (prevents file<->dir & case collisions).
        deletes: list[tuple[str, Path, str]] = []
        copies: list[tuple[str, Path, Path, str, str, dict[str, Any], bool]] = []
        case_handled: set[str] = set()

        # Detect case-insensitive APFS path collisions (same casefold path, different case on A vs B).
        cf_a: dict[str, str] = {p.casefold(): p for p in snap_a}
        cf_b: dict[str, str] = {p.casefold(): p for p in snap_b}
        for cf in sorted(set(cf_a) & set(cf_b)):
            pa, pb = cf_a[cf], cf_b[cf]
            if pa == pb:
                continue
            in_a = snap_a[pa]
            in_b = snap_b[pb]
            # Clean case-only renames (one side unchanged vs prev, other side new) are handled
            # naturally by normal DEL + COPY; only intervene on true case collisions.
            a_is_old_unchanged = matches_prev(in_a, prev_files.get(pa)) and pb not in prev_files
            b_is_old_unchanged = matches_prev(in_b, prev_files.get(pb)) and pa not in prev_files
            if a_is_old_unchanged or b_is_old_unchanged:
                continue

            case_handled.add(pa)
            case_handled.add(pb)
            a_ts = (int(in_a["mtime_ns"]), int(in_a["ctime_ns"]))
            b_ts = (int(in_b["mtime_ns"]), int(in_b["ctime_ns"]))
            if a_ts >= b_ts:
                backup_conflict(DIR_B, pb, "B")
                deletes.append(("DEL B (case conflict)", DIR_B, pb))
                copies.append(("A->B", DIR_A, DIR_B, pa, f"A->B (case conflict, newer) {pa}", in_a, False))
            else:
                backup_conflict(DIR_A, pa, "A")
                deletes.append(("DEL A (case conflict)", DIR_A, pa))
                copies.append(("B->A", DIR_B, DIR_A, pb, f"B->A (case conflict, newer) {pb}", in_b, False))

        for rel in all_paths:
            if rel in case_handled:
                continue
            in_a = snap_a.get(rel)
            in_b = snap_b.get(rel)
            in_p = prev_files.get(rel)

            if in_a and in_b:
                if entry_sig(in_a) == entry_sig(in_b):
                    rec: dict[str, Any] = {
                        "type": in_a["type"],
                        "hash": in_a["hash"],
                        "a": in_a["meta"],
                        "b": in_b["meta"],
                    }
                    if in_a.get("mode") is not None:
                        rec["mode"] = in_a["mode"]
                    new_files[rel] = rec
                    continue

                a_changed = not matches_prev(in_a, in_p)
                b_changed = not matches_prev(in_b, in_p)
                if a_changed and not b_changed:
                    copies.append(("A->B", DIR_A, DIR_B, rel, f"A->B {rel}", in_a, False))
                elif b_changed and not a_changed:
                    copies.append(("B->A", DIR_B, DIR_A, rel, f"B->A {rel}", in_b, False))
                else:
                    a_ts = (int(in_a["mtime_ns"]), int(in_a["ctime_ns"]))
                    b_ts = (int(in_b["mtime_ns"]), int(in_b["ctime_ns"]))
                    if a_ts >= b_ts:
                        copies.append(("A->B", DIR_A, DIR_B, rel, f"A->B (conflict, newer) {rel}", in_a, True))
                    else:
                        copies.append(("B->A", DIR_B, DIR_A, rel, f"B->A (conflict, newer) {rel}", in_b, True))
            elif in_a and not in_b:
                if matches_prev(in_a, in_p):
                    deletes.append(("DEL A", DIR_A, rel))
                else:
                    copies.append(("A->B", DIR_A, DIR_B, rel, f"A->B {rel}", in_a, False))
            elif in_b and not in_a:
                if matches_prev(in_b, in_p):
                    deletes.append(("DEL B", DIR_B, rel))
                else:
                    copies.append(("B->A", DIR_B, DIR_A, rel, f"B->A {rel}", in_b, False))

        # Phase 1: Execute file deletions first.
        for label, root, rel in deletes:
            try:
                remove_entry(root, rel)
                actions.append(f"{label} {rel}")
            except OSError as exc:
                log(f"Error {label} {rel}: {exc}", err=True)
                collision_errors.append(f"del:{rel}")
                if rel in prev_files:
                    new_files[rel] = prev_files[rel]

        # Phase 1b: Remove deleted directories deepest-first before copies so nested
        # directory->file replacements succeed on the same pass.
        planned_file_parents: set[str] = set()
        for rel in set(new_files) | {c[3] for c in copies}:
            p = Path(rel).parent
            while str(p) != ".":
                planned_file_parents.add(p.as_posix())
                p = p.parent

        all_dirs = set(dirs_a) | set(dirs_b) | prev_dirs
        kept_nonempty_dirs: set[str] = set()
        for d in sorted(all_dirs, key=lambda x: (x.count("/"), x), reverse=True):
            if d in planned_file_parents:
                continue
            in_a = d in dirs_a
            in_b = d in dirs_b
            in_p = d in prev_dirs
            if in_a and not in_b and in_p:
                target = DIR_A / d
                try:
                    if target.is_dir() and not target.is_symlink():
                        target.rmdir()
                        actions.append(f"RMDIR A {d}")
                except OSError:
                    kept_nonempty_dirs.add(d)
            elif in_b and not in_a and in_p:
                target = DIR_B / d
                try:
                    if target.is_dir() and not target.is_symlink():
                        target.rmdir()
                        actions.append(f"RMDIR B {d}")
                except OSError:
                    kept_nonempty_dirs.add(d)

        # Phase 2: Execute atomic file/symlink copies and record deterministic state.
        for direction, src_root, dst_root, rel, action_label, src_snap, is_conflict in copies:
            try:
                if is_conflict:
                    losing_side = "B" if direction == "A->B" else "A"
                    backup_conflict(dst_root, rel, losing_side)
                entry_type, copied_hash, copied_mode, dst_meta = copy_entry(src_root, dst_root, rel)
                actions.append(action_label)
                entry: dict[str, Any] = {
                    "type": entry_type,
                    "hash": copied_hash,
                }
                if copied_mode is not None:
                    entry["mode"] = copied_mode
                src_unchanged = copied_hash == src_snap["hash"] and copied_mode == src_snap.get("mode")
                if direction == "A->B":
                    if src_unchanged:
                        entry["a"] = src_snap["meta"]
                    entry["b"] = dst_meta
                else:
                    entry["a"] = dst_meta
                    if src_unchanged:
                        entry["b"] = src_snap["meta"]
                new_files[rel] = entry
            except OSError as exc:
                log(f"Error {action_label}: {exc}", err=True)
                collision_errors.append(f"copy:{rel}")
                if rel in prev_files:
                    new_files[rel] = prev_files[rel]

        # Phase 3: Create missing directories (including empty directories) shallowest-first.
        file_parents: set[str] = set()
        new_files_cf: set[str] = set()
        for rel in new_files:
            new_files_cf.add(rel.casefold())
            p = Path(rel).parent
            while str(p) != ".":
                file_parents.add(p.as_posix())
                p = p.parent

        new_dirs: set[str] = set(file_parents) | kept_nonempty_dirs
        for d in sorted(all_dirs, key=lambda x: (x.count("/"), x)):
            if d in new_files or d.casefold() in new_files_cf:
                continue
            in_a = d in dirs_a
            in_b = d in dirs_b
            in_p = d in prev_dirs
            if in_a and in_b:
                new_dirs.add(d)
            elif in_a and not in_b and not in_p:
                target = DIR_B / d
                if target.is_symlink() or target.is_file():
                    log(f"Collision MKDIR B {d}: non-directory exists at {target}", err=True)
                    collision_errors.append(f"mkdir-b:{d}")
                    continue
                try:
                    target.mkdir(parents=True, exist_ok=True)
                    new_dirs.add(d)
                    actions.append(f"MKDIR B {d}")
                except OSError as exc:
                    log(f"Error MKDIR B {d}: {exc}", err=True)
                    collision_errors.append(f"mkdir-b:{d}")
            elif in_b and not in_a and not in_p:
                target = DIR_A / d
                if target.is_symlink() or target.is_file():
                    log(f"Collision MKDIR A {d}: non-directory exists at {target}", err=True)
                    collision_errors.append(f"mkdir-a:{d}")
                    continue
                try:
                    target.mkdir(parents=True, exist_ok=True)
                    new_dirs.add(d)
                    actions.append(f"MKDIR A {d}")
                except OSError as exc:
                    log(f"Error MKDIR A {d}: {exc}", err=True)
                    collision_errors.append(f"mkdir-a:{d}")

        if collision_errors:
            key = "|".join(sorted(set(collision_errors)))
            sample = ", ".join(sorted(set(collision_errors))[:3])
            notify_once(
                "collision",
                key,
                "Folder Mirror Path Collision",
                f"Manual check needed for: {sample} (see sync.err.log)",
            )
        else:
            clear_alert("collision")

        if git_fastpath or precomputed_git is None:
            new_git = prev_git
        else:
            new_git = sync_git_state(prev_git, precomputed_git, actions)

        new_state = {
            "files": new_files,
            "dirs": sorted(new_dirs),
            "git": new_git,
        }
        if new_state != prev_state:
            save_state(new_state)

        if actions:
            for act in actions:
                log(act)

        rotate_log_file(LOG_FILE)
        rotate_log_file(ERR_LOG_FILE)
        rotate_copytruncate_log_file(LAUNCHD_LOG_FILE)
        rotate_copytruncate_log_file(LAUNCHD_ERR_LOG_FILE)

    return 0, False


def sync(*, wait_seconds: float = 0.0, source: str | None = None) -> int:
    code, _ = sync_once(wait_seconds=wait_seconds, source=source)
    return code


def watch_loop() -> int:
    """Recursive real-time macOS FSEvents daemon with periodic safety reconciliation."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with WATCH_LOCK_FILE.open("a+") as watch_lock_fh:
        if not acquire_lock(watch_lock_fh, 0.0):
            log("Watch daemon already running; exiting duplicate instance", err=True)
            return 0

        stop_requested = False

        def handle_signal(signum: int, _frame: Any) -> None:
            nonlocal stop_requested
            stop_requested = True

        signal.signal(signal.SIGTERM, handle_signal)
        signal.signal(signal.SIGINT, handle_signal)

        # Initial startup sync before waiting on FSEvents.
        _, busy = sync_once(wait_seconds=5.0)

        if sys.platform != "darwin":
            log("Non-macOS platform detected; falling back to 30s polling loop")
            while not stop_requested:
                time.sleep(30.0)
                if not stop_requested:
                    sync_once(wait_seconds=2.0)
            return 0

        cf = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
        cs = ctypes.CDLL("/System/Library/Frameworks/CoreServices.framework/CoreServices")

        kCFStringEncodingUTF8 = 0x08000100
        kFSEventStreamEventIdSinceNow = 0xFFFFFFFFFFFFFFFF
        kFSEventStreamCreateFlagWatchRoot = 0x00000004
        kFSEventStreamCreateFlagIgnoreSelf = 0x00000008
        kFSEventStreamCreateFlagFileEvents = 0x00000010
        kFSEventStreamEventFlagRootChanged = 0x00000020

        cf.CFStringCreateWithCString.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_uint32]
        cf.CFStringCreateWithCString.restype = ctypes.c_void_p
        cf.CFArrayCreate.argtypes = [
            ctypes.c_void_p,
            ctypes.POINTER(ctypes.c_void_p),
            ctypes.c_long,
            ctypes.c_void_p,
        ]
        cf.CFArrayCreate.restype = ctypes.c_void_p
        cf.CFRelease.argtypes = [ctypes.c_void_p]
        cf.CFRelease.restype = None
        cf.CFRunLoopGetCurrent.argtypes = []
        cf.CFRunLoopGetCurrent.restype = ctypes.c_void_p
        cf.CFRunLoopRunInMode.argtypes = [ctypes.c_void_p, ctypes.c_double, ctypes.c_bool]
        cf.CFRunLoopRunInMode.restype = ctypes.c_int32
        cf.CFRunLoopStop.argtypes = [ctypes.c_void_p]
        cf.CFRunLoopStop.restype = None

        kCFTypeArrayCallBacks = ctypes.c_void_p.in_dll(cf, "kCFTypeArrayCallBacks")
        kCFRunLoopDefaultMode = ctypes.c_void_p.in_dll(cf, "kCFRunLoopDefaultMode")

        callback_type = ctypes.CFUNCTYPE(
            None,
            ctypes.c_void_p,
            ctypes.c_void_p,
            ctypes.c_size_t,
            ctypes.POINTER(ctypes.c_char_p),
            ctypes.POINTER(ctypes.c_uint32),
            ctypes.POINTER(ctypes.c_uint64),
        )

        cs.FSEventStreamCreate.argtypes = [
            ctypes.c_void_p,
            callback_type,
            ctypes.c_void_p,
            ctypes.c_void_p,
            ctypes.c_uint64,
            ctypes.c_double,
            ctypes.c_uint32,
        ]
        cs.FSEventStreamCreate.restype = ctypes.c_void_p
        cs.FSEventStreamScheduleWithRunLoop.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p]
        cs.FSEventStreamScheduleWithRunLoop.restype = None
        cs.FSEventStreamStart.argtypes = [ctypes.c_void_p]
        cs.FSEventStreamStart.restype = ctypes.c_bool
        cs.FSEventStreamStop.argtypes = [ctypes.c_void_p]
        cs.FSEventStreamStop.restype = None
        cs.FSEventStreamInvalidate.argtypes = [ctypes.c_void_p]
        cs.FSEventStreamInvalidate.restype = None
        cs.FSEventStreamRelease.argtypes = [ctypes.c_void_p]
        cs.FSEventStreamRelease.restype = None

        run_loop = cf.CFRunLoopGetCurrent()
        dirty = False
        git_dirty = False
        restart_stream = False
        root_a_git = str((DIR_A.resolve() / ".git"))
        root_b_git = str((DIR_B.resolve() / ".git"))

        def is_git_internal_path(raw: bytes | None) -> bool:
            if not raw:
                return False
            p = raw.decode("utf-8", errors="surrogateescape")
            return (
                p == root_a_git
                or p.startswith(root_a_git + "/")
                or p == root_b_git
                or p.startswith(root_b_git + "/")
            )

        @callback_type
        def on_fsevents(
            _stream_ref: Any,
            _info: Any,
            num_events: int,
            event_paths: Any,
            event_flags: Any,
            _event_ids: Any,
        ) -> None:
            nonlocal dirty, git_dirty, restart_stream
            try:
                saw_non_git = False
                for i in range(num_events):
                    if int(event_flags[i]) & kFSEventStreamEventFlagRootChanged:
                        restart_stream = True
                        saw_non_git = True
                    elif not is_git_internal_path(event_paths[i]):
                        saw_non_git = True
                if saw_non_git:
                    dirty = True
                else:
                    git_dirty = True
                cf.CFRunLoopStop(run_loop)
            except Exception:
                dirty = True

        def create_stream() -> Any:
            paths = [str(DIR_A.resolve()), str(DIR_B.resolve())]
            cf_strings: list[Any] = []
            for p in paths:
                s = cf.CFStringCreateWithCString(None, p.encode("utf-8"), kCFStringEncodingUTF8)
                if not s:
                    for prev_s in cf_strings:
                        cf.CFRelease(prev_s)
                    return None
                cf_strings.append(s)
            arr_vals = (ctypes.c_void_p * len(cf_strings))(*cf_strings)
            cf_arr = cf.CFArrayCreate(None, arr_vals, len(cf_strings), ctypes.byref(kCFTypeArrayCallBacks))
            if not cf_arr:
                for s in cf_strings:
                    cf.CFRelease(s)
                return None
            stream_ref = cs.FSEventStreamCreate(
                None,
                on_fsevents,
                None,
                cf_arr,
                kFSEventStreamEventIdSinceNow,
                WATCH_LATENCY_SECONDS,
                kFSEventStreamCreateFlagWatchRoot
                | kFSEventStreamCreateFlagIgnoreSelf
                | kFSEventStreamCreateFlagFileEvents,
            )
            cf.CFRelease(cf_arr)
            for s in cf_strings:
                cf.CFRelease(s)
            if not stream_ref:
                return None
            cs.FSEventStreamScheduleWithRunLoop(stream_ref, run_loop, kCFRunLoopDefaultMode)
            if not cs.FSEventStreamStart(stream_ref):
                cs.FSEventStreamInvalidate(stream_ref)
                cs.FSEventStreamRelease(stream_ref)
                return None
            return stream_ref

        def destroy_stream(stream_ref: Any) -> None:
            if stream_ref:
                cs.FSEventStreamStop(stream_ref)
                cs.FSEventStreamInvalidate(stream_ref)
                cs.FSEventStreamRelease(stream_ref)

        stream = create_stream()
        if not stream:
            log("Failed to start macOS FSEvents stream; falling back to 30s polling loop", err=True)
            while not stop_requested:
                time.sleep(30.0)
                if not stop_requested:
                    sync_once(wait_seconds=2.0)
            return 0

        next_reconcile = time.monotonic() + WATCH_RECONCILE_SECONDS
        busy_retry_at = (time.monotonic() + WATCH_BUSY_RETRY_SECONDS) if busy else 0.0
        last_git_metas = (git_meta_fingerprint(DIR_A), git_meta_fingerprint(DIR_B))

        try:
            while not stop_requested:
                now = time.monotonic()
                timeout = WATCH_RUNLOOP_SLICE_SECONDS
                if busy_retry_at > 0.0:
                    timeout = min(timeout, max(0.05, busy_retry_at - now))
                cf.CFRunLoopRunInMode(kCFRunLoopDefaultMode, timeout, True)
                if stop_requested:
                    break

                now = time.monotonic()
                if restart_stream:
                    restart_stream = False
                    destroy_stream(stream)
                    stream = create_stream()
                    if not stream:
                        log("Failed to restart FSEvents stream after root change", err=True)
                        return 1
                    dirty = True

                # Suppress self-echo FSEvents from child git subprocesses when .git metadata is unchanged.
                if git_dirty and not dirty:
                    git_dirty = False
                    cur_git_metas = (git_meta_fingerprint(DIR_A), git_meta_fingerprint(DIR_B))
                    if cur_git_metas != last_git_metas or cur_git_metas[0] is None or cur_git_metas[1] is None:
                        dirty = True

                should_run = dirty or (busy_retry_at > 0.0 and now >= busy_retry_at) or now >= next_reconcile
                if should_run:
                    dirty = False
                    git_dirty = False
                    try:
                        _, busy = sync_once(wait_seconds=2.0)
                    except Exception as exc:
                        log(f"Unexpected error in watch sync pass: {exc}", err=True)
                        busy = False
                    last_git_metas = (git_meta_fingerprint(DIR_A), git_meta_fingerprint(DIR_B))
                    now = time.monotonic()
                    busy_retry_at = (now + WATCH_BUSY_RETRY_SECONDS) if busy else 0.0
                    next_reconcile = now + WATCH_RECONCILE_SECONDS
        finally:
            destroy_stream(stream)

    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Keep two local folders on macOS mirrored in real time.")
    parser.add_argument(
        "--wait",
        type=float,
        default=0.0,
        help="Seconds to wait for sync lock before skipping (default: 0, non-blocking).",
    )
    parser.add_argument(
        "--source",
        choices=("A", "B"),
        default=None,
        help="Hint indicating which side triggered the sync (used by git hooks).",
    )
    parser.add_argument(
        "--dir-a",
        type=str,
        default=None,
        help="Path to Folder A (overrides MIRROR_DIR_A).",
    )
    parser.add_argument(
        "--dir-b",
        type=str,
        default=None,
        help="Path to Folder B (overrides MIRROR_DIR_B).",
    )
    parser.add_argument(
        "--watch",
        action="store_true",
        help="Run continuously and mirror edits in real time.",
    )
    return parser.parse_args(argv)


if __name__ == "__main__":
    args = parse_args(sys.argv[1:])
    if args.dir_a:
        DIR_A = Path(args.dir_a).expanduser()
    if args.dir_b:
        DIR_B = Path(args.dir_b).expanduser()
    if args.watch:
        sys.exit(watch_loop())
    sys.exit(sync(wait_seconds=args.wait, source=args.source))
